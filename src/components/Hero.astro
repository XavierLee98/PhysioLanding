---
---
<section class="bg-gradient-to-br from-slate-50 via-purple-50/30 to-white py-16 lg:py-24">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-12 items-center">

      <!-- Left content -->
      <div>
        <!-- Trust badge -->
        <div class="inline-flex items-center gap-2 bg-white border border-purple-100 rounded-full px-4 py-2 text-sm text-slate-600 mb-6 shadow-sm">
          <svg class="w-4 h-4 text-green-500" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          Trusted by 1000+ patients
        </div>

        <!-- Heading -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-slate-900 leading-tight mb-6">
          Restore Your<br />
          <span class="gradient-text">Movement,</span> Reclaim<br />
          Your Life
        </h1>

        <p class="text-lg text-slate-500 mb-8 max-w-lg">
          Expert physiotherapy care tailored to your unique needs. Get back to doing what you love with our personalized treatment plans and state-of-the-art facilities.
        </p>

        <!-- CTAs -->
        <div class="flex flex-wrap gap-4 mb-12">
          <a href="#contact" class="btn-primary">Book Consultation</a>
          <a href="#about" class="flex items-center gap-2 text-slate-700 font-semibold hover:text-purple-600 transition-colors">
            <span class="w-10 h-10 rounded-full bg-purple-100 flex items-center justify-center">
              <svg class="w-4 h-4 text-purple-600 ml-0.5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd" />
              </svg>
            </span>
            Watch Our Story
          </a>
        </div>

        <!-- Stats -->
        <div class="flex flex-wrap gap-6 pt-6 border-t border-slate-200">
          <div>
            <p class="text-3xl font-extrabold gradient-text">15+</p>
            <p class="text-sm text-slate-500 mt-1">Years Experience</p>
          </div>
          <div class="w-px bg-slate-200"></div>
          <div>
            <p class="text-3xl font-extrabold gradient-text">5000+</p>
            <p class="text-sm text-slate-500 mt-1">Patients Treated</p>
          </div>
          <div class="w-px bg-slate-200"></div>
          <div>
            <p class="text-3xl font-extrabold gradient-text">98%</p>
            <p class="text-sm text-slate-500 mt-1">Success Rate</p>
          </div>
        </div>
      </div>

      <!-- Right: hero image -->
      <div class="relative flex justify-center lg:justify-end">
        <div class="relative w-full max-w-md">
          <div class="absolute inset-0 bg-gradient-to-br from-purple-200 to-pink-200 rounded-3xl transform rotate-3 scale-105 opacity-50"></div>
          <img
            src="/images/hero-patient.jpg"
            alt="Patient doing physiotherapy exercises"
            class="relative rounded-3xl w-full h-80 lg:h-[480px] object-cover shadow-2xl"
            onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"
          />
          <!-- Placeholder shown when no image -->
          <div class="relative hidden rounded-3xl w-full h-80 lg:h-[480px] bg-gradient-to-br from-purple-100 to-pink-100 items-center justify-center shadow-2xl">
            <div class="text-center text-slate-400">
              <svg class="w-16 h-16 mx-auto mb-2 opacity-40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              <p class="text-sm">Add hero-patient.jpg to public/images/</p>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
