const categories = [
  "All",
  "Rehabilitation",
  "Sports & Performance",
  "Neurological",
  "Pain Management",
  "Pediatric & Women's",
];
---

<section id="services" class="py-20 bg-slate-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Header -->
    <div class="text-center mb-12">
      <span class="inline-block bg-purple-50 border border-purple-200 text-purple-600 text-sm font-semibold px-4 py-1.5 rounded-full mb-4">
        Our Specialties
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 mb-4">
        Comprehensive Care for <span class="gradient-text">Every<br class="hidden sm:block" />Need</span>
      </h2>
      <p class="text-lg text-slate-500 max-w-2xl mx-auto">
        Our team of certified physiotherapists offers 20+ specialized treatments across five disciplines to help you recover, strengthen, and thrive.
      </p>
    </div>

    <!-- Category Tabs -->
    <div class="flex gap-2 overflow-x-auto pb-3 mb-10 -mx-4 px-4 snap-x">
      {categories.map((cat, i) => (
        <button
          class:list={[
            "tab-btn snap-start flex-none whitespace-nowrap px-5 py-2.5 rounded-full text-sm font-semibold transition-all duration-200",
            i === 0
              ? "bg-purple-600 text-white shadow-md shadow-purple-200"
              : "bg-white text-slate-600 border border-slate-200 hover:border-purple-300 hover:text-purple-600"
          ]}
          data-cat={cat}
        >
          {cat}
        </button>
      ))}
    </div>

    <!-- Service Cards Grid -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5" id="services-grid">
      {services.map((s) => (
        <div
          class="service-card bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 cursor-pointer group"
          data-category={s.category}
          data-id={String(s.id)}
        >
          <div class="relative overflow-hidden h-44">
            <img
              src={s.image}
              alt={s.title}
              class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300" />
          </div>
          <div class="p-5">
            <span class={`inline-block text-xs font-semibold px-2.5 py-1 rounded-full mb-3 ${s.badge}`}>
              {s.category}
            </span>
            <h3 class="text-[15px] font-bold text-slate-900 mb-2 leading-snug">{s.title}</h3>
            <p class="text-slate-500 text-sm leading-relaxed mb-4 line-clamp-2">{s.shortDesc}</p>
            <div class="flex gap-2 flex-wrap mb-4">
              <span class="text-xs bg-slate-100 text-slate-600 px-2.5 py-1 rounded-full">⏱ {s.duration}</span>
              <span class="text-xs bg-slate-100 text-slate-600 px-2.5 py-1 rounded-full">📅 {s.sessions}</span>
            </div>
            <button
              class="view-details-btn text-sm font-semibold text-purple-600 hover:text-purple-800 flex items-center gap-1 transition-colors"
              data-id={String(s.id)}
            >
              View Details
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </button>
          </div>
        </div>
      ))}
    </div>

    <!-- Show More button (visible on "All" tab only) -->
    <div class="text-center mt-8" id="show-more-wrapper">
      <button
        id="show-more-btn"
        class="inline-flex items-center gap-2 bg-white border-2 border-purple-200 text-purple-600 hover:bg-purple-600 hover:text-white font-semibold px-8 py-3 rounded-full transition-all duration-200 shadow-sm"
      >
        <span id="show-more-label">Show More Services</span>
        <svg id="show-more-icon" class="w-4 h-4 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
      </button>
    </div>

    <!-- Result count -->
    <p class="text-center text-slate-400 text-sm mt-4" id="result-count">
      Showing 8 of {services.length} services
    </p>

  </div>
</section>

<!-- ── Modal ───────────────────────────────────────────────────────────────── -->
<div
  id="service-modal"
  class="fixed inset-0 z-50 hidden overflow-y-auto"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-title"
>
  <div id="modal-backdrop" class="fixed inset-0 bg-black/60 backdrop-blur-sm"></div>

  <div class="relative flex min-h-full items-center justify-center p-4 sm:p-6">
    <div id="modal-card" class="relative bg-white rounded-3xl max-w-2xl w-full shadow-2xl overflow-hidden">

      <!-- Close -->
      <button
        id="modal-close"
        class="absolute top-4 right-4 z-20 w-9 h-9 bg-white/90 backdrop-blur-sm rounded-full flex items-center justify-center text-slate-500 hover:text-slate-900 shadow-md transition-colors"
        aria-label="Close dialog"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

      <!-- Image -->
      <img id="modal-img" src="" alt="" class="w-full h-56 sm:h-64 object-cover" />

      <!-- Content -->
      <div class="p-6 sm:p-8">
        <span id="modal-badge" class="inline-block text-xs font-semibold px-3 py-1 rounded-full mb-3"></span>
        <h2 id="modal-title" class="text-2xl font-extrabold text-slate-900 mb-3"></h2>
        <p id="modal-desc" class="text-slate-600 leading-relaxed mb-5 text-[15px]"></p>

        <!-- Who it's for + How it works -->
        <div class="grid sm:grid-cols-2 gap-4 mb-5">
          <div class="bg-violet-50 border border-violet-100 rounded-xl p-4">
            <p class="text-xs font-bold text-violet-600 uppercase tracking-wide mb-2">Who It's For</p>
            <p id="modal-whofor" class="text-slate-700 text-sm leading-relaxed"></p>
          </div>
          <div class="bg-purple-50 border border-purple-100 rounded-xl p-4">
            <p class="text-xs font-bold text-purple-600 uppercase tracking-wide mb-2">How It Works</p>
            <p id="modal-howitworks" class="text-slate-700 text-sm leading-relaxed"></p>
          </div>
        </div>

        <!-- Duration + Sessions -->
        <div class="grid grid-cols-2 gap-3 mb-7">
          <div class="bg-slate-50 rounded-xl p-4">
            <p class="text-xs text-slate-400 uppercase tracking-wide font-medium mb-1">Session Duration</p>
            <p id="modal-duration" class="font-bold text-slate-900 text-sm"></p>
          </div>
          <div class="bg-slate-50 rounded-xl p-4">
            <p class="text-xs text-slate-400 uppercase tracking-wide font-medium mb-1">Recommended</p>
            <p id="modal-sessions" class="font-bold text-slate-900 text-sm"></p>
          </div>
        </div>

        <a
          href="#contact"
          class="block text-center bg-purple-600 hover:bg-purple-700 text-white font-bold px-6 py-3.5 rounded-xl transition-colors"
        >
          Book a Consultation
        </a>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ services }}>
  const INITIAL_LIMIT = 8;

  const tabs         = document.querySelectorAll('.tab-btn');
  const cards        = document.querySelectorAll('.service-card');
  const countEl      = document.getElementById('result-count');
  const showMoreWrap = document.getElementById('show-more-wrapper');
  const showMoreBtn  = document.getElementById('show-more-btn');
  const showMoreLbl  = document.getElementById('show-more-label');
  const showMoreIcon = document.getElementById('show-more-icon');

  let currentCat = 'All';
  let expanded   = false;

  // ── Display logic ──────────────────────────────────────────────────────────
  function applyDisplay() {
    const isAll = currentCat === 'All';
    let shown = 0;
    let total = 0;

    cards.forEach(card => {
      const matches = isAll || card.dataset.category === currentCat;
      if (matches) total++;
      const visible = matches && (!isAll || expanded || shown < INITIAL_LIMIT);
      card.style.display = visible ? '' : 'none';
      if (visible) shown++;
    });

    // Count label
    if (countEl) {
      if (isAll && !expanded) {
        countEl.textContent = `Showing ${shown} of ${total} services`;
      } else if (isAll) {
        countEl.textContent = `Showing all ${total} services`;
      } else {
        countEl.textContent = `${total} service${total !== 1 ? 's' : ''} in ${currentCat}`;
      }
    }

    // Show More button: only on "All" tab when there are more cards
    if (isAll && total > INITIAL_LIMIT) {
      showMoreWrap.style.display = '';
      showMoreLbl.textContent = expanded
        ? 'Show Less'
        : `Show ${total - INITIAL_LIMIT} More Services`;
      showMoreIcon.style.transform = expanded ? 'rotate(180deg)' : '';
    } else {
      showMoreWrap.style.display = 'none';
    }
  }

  // ── Tab clicks ─────────────────────────────────────────────────────────────
  function setActiveTab(activeBtn) {
    tabs.forEach(t => {
      t.classList.remove('bg-purple-600', 'text-white', 'shadow-md', 'shadow-purple-200');
      t.classList.add('bg-white', 'text-slate-600', 'border', 'border-slate-200');
    });
    activeBtn.classList.remove('bg-white', 'text-slate-600', 'border', 'border-slate-200');
    activeBtn.classList.add('bg-purple-600', 'text-white', 'shadow-md', 'shadow-purple-200');
  }

  tabs.forEach(btn => {
    btn.addEventListener('click', () => {
      currentCat = btn.dataset.cat;
      expanded   = false;
      setActiveTab(btn);
      applyDisplay();
    });
  });

  // ── Show More / Less ───────────────────────────────────────────────────────
  showMoreBtn.addEventListener('click', () => {
    expanded = !expanded;
    applyDisplay();
    if (!expanded) {
      document.getElementById('services-grid').scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  });

  // Initial render
  applyDisplay();

  // ── Modal ──────────────────────────────────────────────────────────────────
  const modal        = document.getElementById('service-modal');
  const modalClose   = document.getElementById('modal-close');
  const modalBackdrop = document.getElementById('modal-backdrop');

  function openModal(id) {
    const s = services.find(s => s.id === id);
    if (!s) return;
    document.getElementById('modal-img').src = s.image;
    document.getElementById('modal-img').alt = s.title;
    const badge = document.getElementById('modal-badge');
    badge.textContent = s.category;
    badge.className = `inline-block text-xs font-semibold px-3 py-1 rounded-full mb-3 ${s.badge}`;
    document.getElementById('modal-title').textContent = s.title;
    document.getElementById('modal-desc').textContent = s.fullDesc;
    document.getElementById('modal-whofor').textContent = s.whoFor;
    document.getElementById('modal-howitworks').textContent = s.howItWorks;
    document.getElementById('modal-duration').textContent = s.duration;
    document.getElementById('modal-sessions').textContent = s.sessions;
    modal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    modal.classList.add('hidden');
    document.body.style.overflow = '';
  }

  document.querySelectorAll('.view-details-btn').forEach(btn => {
    btn.addEventListener('click', e => {
      e.stopPropagation();
      openModal(parseInt(btn.dataset.id));
    });
  });

  cards.forEach(card => {
    card.addEventListener('click', () => openModal(parseInt(card.dataset.id)));
  });

  modalClose.addEventListener('click', closeModal);
  modalBackdrop.addEventListener('click', closeModal);
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal(); });
  document.getElementById('modal-card').addEventListener('click', e => e.stopPropagation());
</script>
