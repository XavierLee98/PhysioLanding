  category: string;
  title: string;
  shortDesc: string;
  fullDesc: string;
  whoFor: string;
  howItWorks: string;
  image: string;
  duration: string;
  sessions: string;
  badge: string;
};

const services: Service[] = [
  // ── Rehabilitation ────────────────────────────────────────────────────────
  {
    id: 1, category: "Rehabilitation", badge: "bg-violet-100 text-violet-700",
    title: "Orthopedic Therapy",
    shortDesc: "Restore optimal function after bone, joint, and muscle injuries.",
    fullDesc: "Our orthopedic therapy program addresses a broad range of musculoskeletal conditions — from fractures and sprains to joint replacements and chronic arthritis. Therapists combine hands-on mobilization, targeted strength training, and modalities like ultrasound and electrical stimulation to reduce pain, rebuild strength, and restore full mobility.",
    whoFor: "Patients recovering from fractures, sprains, joint replacements, osteoarthritis, tendon injuries, and post-trauma musculoskeletal conditions.",
