    whoFor: "Older adults managing age-related mobility decline, osteoporosis, post-fall recovery, joint replacement, or seeking to maintain independent daily function.",
    howItWorks: "A full functional assessment identifies key movement deficits. Programs focus on balance, gait retraining, strength, and practical home safety strategies with regular progress reviews.",
    image: "https://picsum.photos/seed/eldercare/800/500",
    duration: "45 min", sessions: "12–20 sessions",
  },

  // ── Sports & Performance ──────────────────────────────────────────────────
  {
    id: 6, category: "Sports & Performance", badge: "bg-green-100 text-green-700",
