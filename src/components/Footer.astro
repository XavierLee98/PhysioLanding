---
---
<footer class="bg-slate-900 text-slate-400 pt-16 pb-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-10 mb-12">
      <!-- Brand -->
      <div>
        <a href="/" class="flex items-center gap-2 font-bold text-lg text-white mb-3">
          <span class="w-8 h-8 rounded-md bg-gradient-to-br from-purple-600 to-pink-500 text-white flex items-center justify-center text-sm font-bold">PT</span>
          PhysioCenter
        </a>
        <p class="text-sm leading-relaxed mb-5">
          Leading the way in rehabilitation medicine with personalized care and advanced treatment techniques for over 15 years.
        </p>
        <!-- Social icons -->
        <div class="flex gap-3">
          {[
            { label: 'Facebook', icon: 'M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z' },
            { label: 'Twitter', icon: 'M23 3a10.9 10.9 0 01-3.14 1.53 4.48 4.48 0 00-7.86 3v1A10.66 10.66 0 013 4s-4 9 5 13a11.64 11.64 0 01-7 2c9 5 20 0 20-11.5a4.5 4.5 0 00-.08-.83A7.72 7.72 0 0023 3z' },
            { label: 'Instagram', icon: 'M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37zm1.5-4.87h.01M6.5 19.5h11a2 2 0 002-2v-11a2 2 0 00-2-2h-11a2 2 0 00-2 2v11a2 2 0 002 2z' },
            { label: 'LinkedIn', icon: 'M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6zM2 9h4v12H2z M4 6a2 2 0 100-4 2 2 0 000 4z' },
          ].map((s) => (
            <a href="#" aria-label={s.label}
              class="w-9 h-9 rounded-full bg-slate-800 hover:bg-purple-600 flex items-center justify-center transition-colors">
              <svg class="w-4 h-4 text-slate-400 hover:text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d={s.icon} />
              </svg>
            </a>
          ))}
        </div>
      </div>

      <!-- Our Services -->
      <div>
        <h4 class="text-white font-semibold mb-4">Our Services</h4>
        <ul class="space-y-2 text-sm">
          {['Rehabilitation', 'Sports & Performance', 'Neurological', 'Pain Management', "Pediatric & Women's"].map((s) => (
            <li><a href="#services" class="hover:text-purple-400 transition-colors">{s}</a></li>
          ))}
        </ul>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="text-white font-semibold mb-4">Quick Links</h4>
        <ul class="space-y-2 text-sm">
          {['About Us', 'Our Team', 'Services', 'Patient Resources', 'Insurance', 'Careers'].map((l) => (
            <li><a href="#" class="hover:text-purple-400 transition-colors">{l}</a></li>
          ))}
        </ul>
      </div>

      <!-- Contact Info -->
      <div>
        <h4 class="text-white font-semibold mb-4">Contact Info</h4>
        <ul class="space-y-3 text-sm">
          <li class="flex items-start gap-2">
            <svg class="w-4 h-4 text-purple-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>123 Health Street, Medical District, City, ST 12345</span>
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-purple-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <a href="tel:5551234567" class="hover:text-purple-400 transition-colors">(555) 123-4567</a>
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-purple-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <a href="mailto:info@physiocenter.com" class="hover:text-purple-400 transition-colors">info@physiocenter.com</a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="border-t border-slate-800 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm">
      <p>&copy; 2025 PhysioCenter. All rights reserved.</p>
      <div class="flex gap-4">
        <a href="#" class="hover:text-purple-400 transition-colors">Privacy Policy</a>
        <a href="#" class="hover:text-purple-400 transition-colors">Terms of Service</a>
        <a href="#" class="hover:text-purple-400 transition-colors">HIPAA Notice</a>
      </div>
    </div>

  </div>
</footer>
