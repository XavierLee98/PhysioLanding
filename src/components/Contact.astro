---
---
<section id="contact" class="py-20 bg-slate-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section header -->
    <div class="text-center mb-14">
      <span class="inline-block bg-purple-50 border border-purple-200 text-purple-600 text-sm font-semibold px-4 py-1.5 rounded-full mb-4">
        Get in Touch
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 mb-4">
        Ready to Start Your <span class="gradient-text">Recovery Journey?</span>
      </h2>
      <p class="text-slate-500 text-lg max-w-xl mx-auto">
        Contact us today to schedule your consultation and take the first step towards a healthier, more active you.
      </p>
    </div>

    <div class="grid lg:grid-cols-2 gap-10">

      <!-- Left: Contact form -->
      <div class="bg-white rounded-2xl p-8 shadow-sm border border-slate-100">
        <h3 class="text-xl font-bold text-slate-800 mb-6 flex items-center gap-2">
          <svg class="w-5 h-5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
          </svg>
          Send us a Message
        </h3>

        <form id="contact-form" class="space-y-4">
          <div class="grid sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wide mb-1" for="first-name">First Name</label>
              <input id="first-name" name="first-name" type="text" placeholder="John" required
                class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-purple-300 focus:border-purple-400 transition" />
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wide mb-1" for="last-name">Last Name</label>
              <input id="last-name" name="last-name" type="text" placeholder="Doe" required
                class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-purple-300 focus:border-purple-400 transition" />
            </div>
          </div>

          <div class="grid sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wide mb-1" for="email">Email</label>
              <input id="email" name="email" type="email" placeholder="john@example.com" required
                class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-purple-300 focus:border-purple-400 transition" />
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wide mb-1" for="phone">Phone</label>
              <input id="phone" name="phone" type="tel" placeholder="(555) 123-4567"
                class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-purple-300 focus:border-purple-400 transition" />
            </div>
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wide mb-1" for="message">How can we help you?</label>
            <textarea id="message" name="message" rows="4" placeholder="Tell us about your condition, symptoms, or questions..." required
              class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-purple-300 focus:border-purple-400 transition resize-none"></textarea>
          </div>

          <button type="submit"
            class="w-full btn-primary py-4 text-base">
            Send Message
          </button>

          <p id="form-status" class="text-center text-sm hidden"></p>
        </form>
      </div>

      <!-- Right: Contact info -->
      <div class="flex flex-col gap-4">
        {[
          {
            icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />`,
            bg: 'bg-purple-100',
            color: 'text-purple-600',
            title: 'Visit Us',
            lines: ['123 Health Street', 'Medical District', 'City, ST 12345'],
          },
          {
            icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />`,
            bg: 'bg-pink-100',
            color: 'text-pink-600',
            title: 'Call Us',
            lines: ['(555) 123-4567', 'Emergency: (555) 999-0000'],
          },
          {
            icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />`,
            bg: 'bg-blue-100',
            color: 'text-blue-600',
            title: 'Email Us',
            lines: ['info@physiocenter.com', 'appointments@physiocenter.com'],
          },
          {
            icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />`,
            bg: 'bg-orange-100',
            color: 'text-orange-600',
            title: 'Hours',
            lines: ['Mon–Fri: 7AM – 8PM', 'Sat: 8AM – 5PM', 'Sun: Closed'],
          },
        ].map((item) => (
          <div class="bg-white rounded-2xl p-5 shadow-sm border border-slate-100 flex items-start gap-4">
            <div class={`w-10 h-10 ${item.bg} rounded-xl flex items-center justify-center flex-shrink-0`}>
              <svg class={`w-5 h-5 ${item.color}`} fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={item.icon} />
            </div>
            <div>
              <p class="font-semibold text-slate-800 text-sm mb-1">{item.title}</p>
              {item.lines.map((l) => <p class="text-slate-500 text-sm">{l}</p>)}
            </div>
          </div>
        ))}

        <!-- Action buttons -->
        <a href="#contact" class="btn-primary text-center py-4 flex items-center justify-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          Book Appointment
        </a>
        <a href="tel:5551234567" class="btn-outline text-center py-4 flex items-center justify-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          Call Now
        </a>
      </div>

    </div>
  </div>
</section>

<script>
  /*
   * Replace GOOGLE_FORM_URL with your Google Form's action URL.
   * Steps:
   * 1. Create a Google Form with fields: First Name, Last Name, Email, Phone, Message
   * 2. Click "Send" in the form editor → get the pre-filled link
   * 3. Replace entry IDs below with yours (inspect the form source to find entry.XXXXXXXXX values)
   */
  const GOOGLE_FORM_URL = 'https://docs.google.com/forms/d/e/YOUR_FORM_ID/formResponse';
  const FIELD_MAP = {
    'first-name': 'entry.FIELD_1',
    'last-name':  'entry.FIELD_2',
    'email':      'entry.FIELD_3',
    'phone':      'entry.FIELD_4',
    'message':    'entry.FIELD_5',
  };

  const form = document.getElementById('contact-form') as HTMLFormElement;
  const status = document.getElementById('form-status') as HTMLParagraphElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    btn.disabled = true;
    btn.textContent = 'Sending...';

    const body = new FormData();
    for (const [fieldId, entryKey] of Object.entries(FIELD_MAP)) {
      const el = document.getElementById(fieldId) as HTMLInputElement | HTMLTextAreaElement;
      body.append(entryKey, el?.value ?? '');
    }

    try {
      await fetch(GOOGLE_FORM_URL, { method: 'POST', body, mode: 'no-cors' });
      form.reset();
      status.textContent = 'Message sent! We\'ll be in touch soon.';
      status.className = 'text-center text-sm text-green-600';
    } catch {
      status.textContent = 'Something went wrong. Please try calling us directly.';
      status.className = 'text-center text-sm text-red-500';
    } finally {
      status.classList.remove('hidden');
      btn.disabled = false;
      btn.textContent = 'Send Message';
    }
  });
</script>
